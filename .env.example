# MySQL
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=replace-with-a-secret
DB_NAME=your-database-name
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# App security (generate a random value of at least 32 characters)
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: protect /admin/database with HTTP Basic auth (username: admin)
ADMIN_DATABASE_TOKEN=replace-with-a-long-random-token

NODE_ENV=development
PORT=3000
